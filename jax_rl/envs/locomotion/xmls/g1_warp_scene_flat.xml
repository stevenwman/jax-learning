<mujoco model="g1 warp flat terrain scene">
  <!-- Feet-only G1 collision (vendored from mujoco_playground). Trains way
       faster than the full self-collision model from menagerie's g1_mjx.xml
       because only feet × floor + minimal self-contact pairs are active. -->
  <include file="unitree_g1/g1_feetonly.xml"/>

  <statistic center="0 0 0.7" extent="1.2" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="140" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1"
      markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane"/>
  </worldbody>

  <!-- Bare-name sensor aliases. The feetonly model's sensors are suffixed
       (gyro_pelvis, accelerometer_pelvis, etc.); we alias them as bare names
       so the env code matches Go2's pattern (gyro, accelerometer, ...). -->
  <sensor>
    <gyro site="imu_in_pelvis" name="gyro"/>
    <accelerometer site="imu_in_pelvis" name="accelerometer"/>
    <velocimeter site="imu_in_pelvis" name="local_linvel"/>
    <framezaxis objtype="site" objname="imu_in_pelvis" name="upvector"/>
    <framexaxis objtype="site" objname="imu_in_pelvis" name="forwardvector"/>
    <framelinvel objtype="site" objname="imu_in_pelvis" name="global_linvel"/>
    <frameangvel objtype="site" objname="imu_in_pelvis" name="global_angvel"/>
    <!-- Per-foot position relative to pelvis IMU. -->
    <framepos objtype="site" objname="left_foot" name="left_foot_pos" reftype="site" refname="imu_in_pelvis"/>
    <framepos objtype="site" objname="right_foot" name="right_foot_pos" reftype="site" refname="imu_in_pelvis"/>
    <!-- Floor-contact-found per foot. The feetonly XML uses a single foot box
         per side as the "foot" geom (not 3 capsules), so this fires when
         the foot box overlaps the floor. -->
    <contact name="left_foot_floor_found" geom1="left_foot" geom2="floor"
             reduce="mindist" num="1" data="found"/>
    <contact name="right_foot_floor_found" geom1="right_foot" geom2="floor"
             reduce="mindist" num="1" data="found"/>
  </sensor>

  <keyframe>
    <key name="home"
      qpos="
      0 0 0.785
      1 0 0 0
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "
      ctrl="
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
    <!-- knees_bent: half-squat spawn pose. Way more stable for SAC random
         exploration than rigid stand (home). DeepMind's playground spawns
         from this; following their recipe. -->
    <key name="knees_bent"
      qpos="
      0 0 0.755
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      "
      ctrl="
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      "/>
  </keyframe>
</mujoco>
