<mujoco model="treadmill_splitbelt">
  <!--
    Robot-agnostic split-belt treadmill apparatus.
    Two long belt slabs on slide joints driven by velocity actuators.
    Use as <include> from a robot-specific scene XML. See spec S§5.1.
  -->

  <option timestep="0.004"/>

  <asset>
    <!-- Checker textures so belt motion is visible at render time. Different
         hues per side so visual side identification is unambiguous. -->
    <texture name="left_belt_tex"  type="2d" builtin="checker" rgb1="0.25 0.45 0.65" rgb2="0.15 0.30 0.45"
             width="64" height="512"/>
    <texture name="right_belt_tex" type="2d" builtin="checker" rgb1="0.65 0.40 0.30" rgb2="0.45 0.25 0.20"
             width="64" height="512"/>
    <material name="left_belt_mat"  texture="left_belt_tex"  texrepeat="50 2" specular="0.1" shininess="0.1"/>
    <material name="right_belt_mat" texture="right_belt_tex" texrepeat="50 2" specular="0.1" shininess="0.1"/>
  </asset>

  <default>
    <default class="treadmill_belt">
      <geom type="box" friction="1.0 0.005 0.0001"/>
      <joint type="slide" axis="1 0 0" damping="0" frictionloss="0"/>
    </default>
  </default>

  <worldbody>
    <!-- Lighting. directional=true → infinite distance, no cone, no falloff —
         lights belt uniformly regardless of x position (otherwise spot-cone
         falloff darkens parts of the slab as it scrolls past the cone). -->
    <light name="overhead"   directional="true" pos="0 0 5.0"  dir="0 0 -1"     diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
    <light name="fill_front" directional="true" pos="2 0 2.0"  dir="-1 0 -0.5"  diffuse="0.3 0.3 0.3"/>
    <light name="fill_side"  directional="true" pos="0 2 2.0"  dir="0 -1 -0.5" diffuse="0.3 0.3 0.3"/>
    <!-- Static fallback floor — fills ONLY the gap between belts (y in [-0.025, 0.025])
         and the regions outside belts (|y| > 0.325). Must be a finite BOX, not a plane:
         planes are infinite in MuJoCo, and the floor_found contact sensor would fire
         for any foot near z=0 even when on a belt (margin-based detection). With a box,
         floor_found fires only when a foot is geometrically over the gap or off-the-side.

         The "outside belts" regions are caught by a wider box; we use a single box
         that's wider than the belt span (y in [-2, 2]) but THIN in z, sitting just
         below the belt surface. The narrow gap between belts (y∈[-0.025, 0.025]) and
         the outside-belt regions (|y|>0.325) are uncovered by belts → only the
         fallback_floor catches them. Under the belts (y∈[-0.325,-0.025] ∪ [0.025,0.325]),
         feet hit the belt slab first (z=0..0.01) before reaching fallback_floor below.

         Box dimensions: 50m × 2m × 0.005m (half-extents). Top surface at z=-0.005,
         so 5mm below belt surface — feet on a belt never touch this. -->
    <geom name="fallback_floor"
          type="box"
          size="50 2.0 0.005"
          pos="0 0 -0.010"
          rgba="0.6 0.55 0.5 1"
          friction="1.0 0.005 0.0001"/>

    <!-- Left belt: y in [-0.325, -0.025], slides along world x. -->
    <body name="left_belt" pos="0 -0.175 0">
      <joint name="left_belt_joint" class="treadmill_belt"/>
      <geom name="left_belt_geom" class="treadmill_belt" size="25 0.15 0.005" material="left_belt_mat"/>
    </body>

    <!-- Right belt: y in [0.025, 0.325]. -->
    <body name="right_belt" pos="0 0.175 0">
      <joint name="right_belt_joint" class="treadmill_belt"/>
      <geom name="right_belt_geom" class="treadmill_belt" size="25 0.15 0.005" material="right_belt_mat"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Velocity actuators: ctrl = target velocity (m/s). High kv for tight tracking.
         forcerange explicit: Go2WarpEnv.__init__:64-67 clobbers `actuator_forcerange`
         to match `actuator_ctrlrange`. Splitbelt env's _post_init re-mutates this
         field and re-puts the model — but the XML default is also generous in case
         someone uses this asset without that override. -->
    <velocity name="left_belt_vel"  joint="left_belt_joint"  kv="200" ctrlrange="-3.0 3.0" forcerange="-200 200"/>
    <velocity name="right_belt_vel" joint="right_belt_joint" kv="200" ctrlrange="-3.0 3.0" forcerange="-200 200"/>
  </actuator>
</mujoco>
